//@version=6
indicator("Trade Vision 24/7 — Core V1", "TV24 Core V1", overlay=true, max_labels_count=200, max_lines_count=100, max_boxes_count=30)

// =========================================================
// TRADE VISION 24/7 — TRADINGVIEW CORE V1
// 4H liquidity sweep/reclaim -> 15M BOS -> FVG/OB -> LIMIT
// Uses confirmed candles for signal generation.
// Designed primarily for a 15 minute chart.
// =========================================================

// ------------------------- INPUTS -------------------------
grpCore = "Core"
structureLen = input.int(12, "15M structure length", minval=5, maxval=50, group=grpCore)
obSearch      = input.int(8, "OB origin search", minval=3, maxval=20, group=grpCore)
fvgMaxAge    = input.int(12, "Max FVG age (bars)", minval=2, maxval=40, group=grpCore)
atrLen        = input.int(55, "ATR length", minval=5, maxval=200, group=grpCore)
slAtrBuffer   = input.float(0.35, "SL ATR buffer", minval=0.05, step=0.05, group=grpCore)
minRiskAtr    = input.float(0.65, "Minimum risk ATR", minval=0.10, step=0.05, group=grpCore)

showWatch  = input.bool(true, "Show WATCH", group="Visual")
showLevels = input.bool(false, "Show HTF liquidity levels", group="Visual")
showZones  = input.bool(true, "Show active entry zone", group="Visual")
showPriceLabels = input.bool(true, "Show ENTRY / SL / TP labels", group="Visual")
planBars = input.int(40, "Plan line length", minval=10, maxval=150, group="Visual")

// ------------------------- HELPERS -------------------------
f_mid(float a, float b) => (a + b) / 2.0

f_rr_target(string side, float entry, float risk, float rr) =>
    side == "LONG" ? entry + risk * rr : entry - risk * rr

// ------------------------- HTF LIQUIDITY -------------------------
pdh = request.security(syminfo.tickerid, "D", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pwh = request.security(syminfo.tickerid, "W", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1],  gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pmh = request.security(syminfo.tickerid, "M", high[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
pml = request.security(syminfo.tickerid, "M", low[1],  gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

h4High  = request.security(syminfo.tickerid, "240", high[1],  gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
h4Low   = request.security(syminfo.tickerid, "240", low[1],   gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
h4Close = request.security(syminfo.tickerid, "240", close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

longPML = h4Low < pml and h4Close > pml
longPWL = h4Low < pwl and h4Close > pwl
longPDL = h4Low < pdl and h4Close > pdl

shortPMH = h4High > pmh and h4Close < pmh
shortPWH = h4High > pwh and h4Close < pwh
shortPDH = h4High > pdh and h4Close < pdh

htfLongSweep  = longPML or longPWL or longPDL
htfShortSweep = shortPMH or shortPWH or shortPDH

longLevelName = longPML ? "PML" : longPWL ? "PWL" : longPDL ? "PDL" : ""
shortLevelName = shortPMH ? "PMH" : shortPWH ? "PWH" : shortPDH ? "PDH" : ""

longReclaim = longPML ? pml : longPWL ? pwl : longPDL ? pdl : na
shortReclaim = shortPMH ? pmh : shortPWH ? pwh : shortPDH ? pdh : na

// ------------------------- 15M STRUCTURE -------------------------
prevStructureHigh = ta.highest(high[1], structureLen)
prevStructureLow  = ta.lowest(low[1], structureLen)

bullBOS = barstate.isconfirmed and close > prevStructureHigh
bearBOS = barstate.isconfirmed and close < prevStructureLow

// ------------------------- FVG -------------------------
atr = ta.atr(atrLen)
bodyDelta = math.abs(close[1] - open[1])
bodyStrong = bodyDelta >= atr[1] * 0.35

bullFvgNew = barstate.isconfirmed and low > high[2] and close[1] > high[2] and bodyStrong
bearFvgNew = barstate.isconfirmed and high < low[2] and close[1] < low[2] and bodyStrong

var float bullFvgLow = na
var float bullFvgHigh = na
var int bullFvgBar = na
var float bearFvgLow = na
var float bearFvgHigh = na
var int bearFvgBar = na

if bullFvgNew
    bullFvgLow := high[2]
    bullFvgHigh := low
    bullFvgBar := bar_index

if bearFvgNew
    bearFvgLow := high
    bearFvgHigh := low[2]
    bearFvgBar := bar_index

if not na(bullFvgLow) and low < bullFvgLow
    bullFvgLow := na
    bullFvgHigh := na
    bullFvgBar := na

if not na(bearFvgHigh) and high > bearFvgHigh
    bearFvgLow := na
    bearFvgHigh := na
    bearFvgBar := na

bullFvgValid = not na(bullFvgBar) and bar_index - bullFvgBar <= fvgMaxAge
bearFvgValid = not na(bearFvgBar) and bar_index - bearFvgBar <= fvgMaxAge

// ------------------------- BOS-LINKED ORDER BLOCK -------------------------
float bullObLow = na
float bullObHigh = na
float bearObLow = na
float bearObHigh = na

if bullBOS
    for i = 1 to obSearch
        if na(bullObLow) and close[i] < open[i]
            bullObLow := low[i]
            bullObHigh := high[i]

if bearBOS
    for i = 1 to obSearch
        if na(bearObLow) and close[i] > open[i]
            bearObLow := low[i]
            bearObHigh := high[i]

// ------------------------- ENTRY BUILD -------------------------
float longZoneLow = na
float longZoneHigh = na
float longEntry = na
string longEntryType = ""

if bullBOS
    overlapLowL = bullFvgValid and not na(bullObLow) ? math.max(bullFvgLow, bullObLow) : na
    overlapHighL = bullFvgValid and not na(bullObHigh) ? math.min(bullFvgHigh, bullObHigh) : na
    hasOverlapL = not na(overlapLowL) and not na(overlapHighL) and overlapHighL > overlapLowL
    if hasOverlapL
        longZoneLow := overlapLowL
        longZoneHigh := overlapHighL
        longEntry := f_mid(overlapLowL, overlapHighL)
        longEntryType := "FVG + OB"
    else if bullFvgValid
        longZoneLow := bullFvgLow
        longZoneHigh := bullFvgHigh
        longEntry := f_mid(bullFvgLow, bullFvgHigh)
        longEntryType := "FVG 50%"
    else if not na(bullObLow)
        longZoneLow := bullObLow
        longZoneHigh := bullObHigh
        longEntry := f_mid(bullObLow, bullObHigh)
        longEntryType := "OB 50%"

float shortZoneLow = na
float shortZoneHigh = na
float shortEntry = na
string shortEntryType = ""

if bearBOS
    overlapLowS = bearFvgValid and not na(bearObLow) ? math.max(bearFvgLow, bearObLow) : na
    overlapHighS = bearFvgValid and not na(bearObHigh) ? math.min(bearFvgHigh, bearObHigh) : na
    hasOverlapS = not na(overlapLowS) and not na(overlapHighS) and overlapHighS > overlapLowS
    if hasOverlapS
        shortZoneLow := overlapLowS
        shortZoneHigh := overlapHighS
        shortEntry := f_mid(overlapLowS, overlapHighS)
        shortEntryType := "FVG + OB"
    else if bearFvgValid
        shortZoneLow := bearFvgLow
        shortZoneHigh := bearFvgHigh
        shortEntry := f_mid(bearFvgLow, bearFvgHigh)
        shortEntryType := "FVG 50%"
    else if not na(bearObLow)
        shortZoneLow := bearObLow
        shortZoneHigh := bearObHigh
        shortEntry := f_mid(bearObLow, bearObHigh)
        shortEntryType := "OB 50%"

longSignal = htfLongSweep and bullBOS and not na(longEntry)
shortSignal = htfShortSweep and bearBOS and not na(shortEntry)

// ------------------------- SMART STRUCTURAL SL V1 -------------------------
recentLow = ta.lowest(low[1], 16)
recentHigh = ta.highest(high[1], 16)

float longSL = na
float shortSL = na
float longRisk = na
float shortRisk = na

if longSignal
    anchorL = math.min(longZoneLow, math.min(longReclaim, recentLow))
    rawSL = anchorL - atr * slAtrBuffer
    minimumRisk = atr * minRiskAtr
    longSL := math.min(rawSL, longEntry - minimumRisk)
    longRisk := longEntry - longSL

if shortSignal
    anchorS = math.max(shortZoneHigh, math.max(shortReclaim, recentHigh))
    rawSL = anchorS + atr * slAtrBuffer
    minimumRisk = atr * minRiskAtr
    shortSL := math.max(rawSL, shortEntry + minimumRisk)
    shortRisk := shortSL - shortEntry

longTP1 = longSignal ? f_rr_target("LONG", longEntry, longRisk, 0.70) : na
longTP2 = longSignal ? f_rr_target("LONG", longEntry, longRisk, 1.30) : na
longTP3 = longSignal ? f_rr_target("LONG", longEntry, longRisk, 2.00) : na
longTP4 = longSignal ? f_rr_target("LONG", longEntry, longRisk, 3.00) : na

shortTP1 = shortSignal ? f_rr_target("SHORT", shortEntry, shortRisk, 0.70) : na
shortTP2 = shortSignal ? f_rr_target("SHORT", shortEntry, shortRisk, 1.30) : na
shortTP3 = shortSignal ? f_rr_target("SHORT", shortEntry, shortRisk, 2.00) : na
shortTP4 = shortSignal ? f_rr_target("SHORT", shortEntry, shortRisk, 3.00) : na

// ------------------------- VISUAL STATE -------------------------
watchLong = showWatch and htfLongSweep and not bullBOS
watchShort = showWatch and htfShortSweep and not bearBOS

plotshape(watchLong and not watchLong[1], title="WATCH LONG", style=shape.labelup, location=location.belowbar, text="WATCH\nLONG", size=size.tiny, force_overlay=true)
plotshape(watchShort and not watchShort[1], title="WATCH SHORT", style=shape.labeldown, location=location.abovebar, text="WATCH\nSHORT", size=size.tiny, force_overlay=true)
plotshape(longSignal, title="LONG", style=shape.labelup, location=location.belowbar, text="LONG", size=size.small, force_overlay=true)
plotshape(shortSignal, title="SHORT", style=shape.labeldown, location=location.abovebar, text="SHORT", size=size.small, force_overlay=true)

// Keep only the latest trade plan on the MAIN PRICE CHART.
var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
var line tp4Line = na
var box zoneBox = na
var label infoLabel = na
var label entryPriceLabel = na
var label slPriceLabel = na
var label tp1PriceLabel = na
var label tp2PriceLabel = na
var label tp3PriceLabel = na
var label tp4PriceLabel = na

f_clear_plan() =>
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(tp3Line)
        line.delete(tp3Line)
    if not na(tp4Line)
        line.delete(tp4Line)
    if not na(zoneBox)
        box.delete(zoneBox)
    if not na(infoLabel)
        label.delete(infoLabel)
    if not na(entryPriceLabel)
        label.delete(entryPriceLabel)
    if not na(slPriceLabel)
        label.delete(slPriceLabel)
    if not na(tp1PriceLabel)
        label.delete(tp1PriceLabel)
    if not na(tp2PriceLabel)
        label.delete(tp2PriceLabel)
    if not na(tp3PriceLabel)
        label.delete(tp3PriceLabel)
    if not na(tp4PriceLabel)
        label.delete(tp4PriceLabel)

if longSignal
    f_clear_plan()
    endBar = bar_index + planBars
    entryLine := line.new(bar_index, longEntry, endBar, longEntry, extend=extend.none, color=color.yellow, style=line.style_dashed, width=3, force_overlay=true)
    slLine := line.new(bar_index, longSL, endBar, longSL, extend=extend.none, color=color.red, width=2, force_overlay=true)
    tp1Line := line.new(bar_index, longTP1, endBar, longTP1, color=color.lime, width=1, force_overlay=true)
    tp2Line := line.new(bar_index, longTP2, endBar, longTP2, color=color.lime, width=1, force_overlay=true)
    tp3Line := line.new(bar_index, longTP3, endBar, longTP3, color=color.lime, width=1, force_overlay=true)
    tp4Line := line.new(bar_index, longTP4, endBar, longTP4, color=color.lime, width=1, force_overlay=true)
    if showZones
        zoneBox := box.new(bar_index, longZoneHigh, endBar, longZoneLow, bgcolor=color.new(color.green, 88), border_color=color.new(color.green, 55), force_overlay=true)
    infoLabel := label.new(bar_index, low, "LONG 🟢\n" + longLevelName + " sweep → 15M BOS\n" + longEntryType, style=label.style_label_up, textcolor=color.white, color=color.new(color.green, 15), force_overlay=true)
    if showPriceLabels
        entryPriceLabel := label.new(endBar, longEntry, "ENTRY  " + str.tostring(longEntry, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.yellow, size=size.small, force_overlay=true)
        slPriceLabel := label.new(endBar, longSL, "SL  " + str.tostring(longSL, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.red, size=size.tiny, force_overlay=true)
        tp1PriceLabel := label.new(endBar, longTP1, "TP1  " + str.tostring(longTP1, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.lime, size=size.tiny, force_overlay=true)
        tp2PriceLabel := label.new(endBar, longTP2, "TP2  " + str.tostring(longTP2, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.lime, size=size.tiny, force_overlay=true)
        tp3PriceLabel := label.new(endBar, longTP3, "TP3  " + str.tostring(longTP3, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.lime, size=size.tiny, force_overlay=true)
        tp4PriceLabel := label.new(endBar, longTP4, "TP4  " + str.tostring(longTP4, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.lime, size=size.tiny, force_overlay=true)

if shortSignal
    f_clear_plan()
    endBar = bar_index + planBars
    entryLine := line.new(bar_index, shortEntry, endBar, shortEntry, extend=extend.none, color=color.yellow, style=line.style_dashed, width=3, force_overlay=true)
    slLine := line.new(bar_index, shortSL, endBar, shortSL, extend=extend.none, color=color.red, width=2, force_overlay=true)
    tp1Line := line.new(bar_index, shortTP1, endBar, shortTP1, color=color.aqua, width=1, force_overlay=true)
    tp2Line := line.new(bar_index, shortTP2, endBar, shortTP2, color=color.aqua, width=1, force_overlay=true)
    tp3Line := line.new(bar_index, shortTP3, endBar, shortTP3, color=color.aqua, width=1, force_overlay=true)
    tp4Line := line.new(bar_index, shortTP4, endBar, shortTP4, color=color.aqua, width=1, force_overlay=true)
    if showZones
        zoneBox := box.new(bar_index, shortZoneHigh, endBar, shortZoneLow, bgcolor=color.new(color.red, 88), border_color=color.new(color.red, 55), force_overlay=true)
    infoLabel := label.new(bar_index, high, "SHORT 🔴\n" + shortLevelName + " sweep → 15M BOS\n" + shortEntryType, style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 15), force_overlay=true)
    if showPriceLabels
        entryPriceLabel := label.new(endBar, shortEntry, "ENTRY  " + str.tostring(shortEntry, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.yellow, size=size.small, force_overlay=true)
        slPriceLabel := label.new(endBar, shortSL, "SL  " + str.tostring(shortSL, format.mintick), style=label.style_label_left, textcolor=color.white, color=color.red, size=size.tiny, force_overlay=true)
        tp1PriceLabel := label.new(endBar, shortTP1, "TP1  " + str.tostring(shortTP1, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.aqua, size=size.tiny, force_overlay=true)
        tp2PriceLabel := label.new(endBar, shortTP2, "TP2  " + str.tostring(shortTP2, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.aqua, size=size.tiny, force_overlay=true)
        tp3PriceLabel := label.new(endBar, shortTP3, "TP3  " + str.tostring(shortTP3, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.aqua, size=size.tiny, force_overlay=true)
        tp4PriceLabel := label.new(endBar, shortTP4, "TP4  " + str.tostring(shortTP4, format.mintick), style=label.style_label_left, textcolor=color.black, color=color.aqua, size=size.tiny, force_overlay=true)

// Optional liquidity display - also forced onto the main chart.
plot(showLevels ? pdh : na, "PDH", color=color.new(color.red, 65), style=plot.style_linebr, force_overlay=true)
plot(showLevels ? pdl : na, "PDL", color=color.new(color.green, 65), style=plot.style_linebr, force_overlay=true)
plot(showLevels ? pwh : na, "PWH", color=color.new(color.red, 45), style=plot.style_linebr, force_overlay=true)
plot(showLevels ? pwl : na, "PWL", color=color.new(color.green, 45), style=plot.style_linebr, force_overlay=true)
plot(showLevels ? pmh : na, "PMH", color=color.new(color.red, 25), style=plot.style_linebr, force_overlay=true)
plot(showLevels ? pml : na, "PML", color=color.new(color.green, 25), style=plot.style_linebr, force_overlay=true)

// ------------------------- ALERTS -------------------------
alertcondition(watchLong and not watchLong[1], "Trade Vision WATCH LONG", "Trade Vision: HTF liquidity sweep/reclaim. Waiting for 15M bullish BOS.")
alertcondition(watchShort and not watchShort[1], "Trade Vision WATCH SHORT", "Trade Vision: HTF liquidity sweep/reclaim. Waiting for 15M bearish BOS.")
alertcondition(longSignal, "Trade Vision LONG", "Trade Vision LONG confirmed: HTF sweep + 15M BOS + retrace zone.")
alertcondition(shortSignal, "Trade Vision SHORT", "Trade Vision SHORT confirmed: HTF sweep + 15M BOS + retrace zone.")
